# EAS Build ignore (monorepo root). Keeps the upload small and prevents
# read-only tool caches (e.g. .cache/dotslash) from breaking the archive.

# Dependencies & caches (reinstalled/regenerated during the EAS cloud build)
node_modules/
.cache/
.pnpm-store/

# Version control & logs
.git/
*.log

# Expo / native build artifacts (regenerated by EAS)
.expo/
dist/
build/
web-build/
android/
ios/
.metro-health-check*

# Replit / agent internal (not needed for the mobile build)
.local/
.agents/
.upm/
